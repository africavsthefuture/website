---
import { Picture } from "astro:assets";
import { img, coverImg, fmtDate, platformLabel, type Article } from "../lib/content";
import { topicOf } from "../lib/cover.mjs";
const { a, big = false, eager = false } = Astro.props as { a: Article; big?: boolean; eager?: boolean };
const remote = img(a.image);
const i = remote ?? coverImg(`article-${a.slug}`);
const topic = topicOf(`${a.title} ${a.tags.join(" ")}`).label;
const alt = remote ? `Cover image for “${a.title}”` : `Abstract teal-and-gold ${topic.toLowerCase()} motif for “${a.title}”`;
---
<article class:list={["card", "article-card", { big }]}>
  <a href={`/articles/${a.slug}`} class="card-link">
    <div class="card-media">
      {i ? <Picture src={i} formats={["avif"]} fallbackFormat="webp" widths={big ? [480, 800, 1200] : [400, 640]} sizes={big ? "(min-width: 900px) 60vw, 100vw" : "(min-width: 900px) 30vw, 100vw"} alt={alt} loading={eager ? "eager" : "lazy"} fetchpriority={eager ? "high" : "auto"} />
         : <div class="card-media-fallback" aria-hidden="true">VS</div>}
      <span class="chip chip-read">{a.words ? `${Math.max(1, Math.round(a.words / 230))} min read` : "Essay"}</span>
      <span class="chip chip-topic">{topic}</span>
    </div>
    <div class="card-body">
      <p class="meta"><time datetime={a.published}>{fmtDate(a.published)}</time> · {a.author}</p>
      <h3 class="card-title">{a.title}</h3>
      {a.subtitle && <p class="card-sub">{a.subtitle}</p>}
      {big && <p class="card-excerpt">{a.excerpt}</p>}
    </div>
  </a>
</article>
