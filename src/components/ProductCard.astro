---
// Store card: image + title open the product page; the gold button goes straight to Gumroad.
import { Picture } from "astro:assets";
import { img, coverImg, priceLabel, productPath, displayName, kindLabel, type Product } from "../lib/content";
import { utm } from "../site.config.mjs";
const { p, placement = "card" } = Astro.props as { p: Product; placement?: string };
const remote = img(p.image);
const i = remote ?? coverImg(`product-${p.slug}`);
const name = displayName(p);
const buy = utm(p.url, "store", `${placement}_buy_${p.slug}`);
---
<article class="card product-card">
  <a href={productPath(p)} class="card-link" aria-label={`${name}: details`}>
    <div class="card-media cover">
      {i ? <Picture src={i} formats={["avif"]} fallbackFormat="webp" widths={[400, 640]} sizes="(min-width: 900px) 30vw, 90vw" alt={remote ? `Cover of ${name} (${kindLabel(p)}), Thought Leaders` : `Generated cover for ${name}, Thought Leaders`} loading="lazy" />
         : <div class="card-media-fallback" aria-hidden="true">VS</div>}
      <span class="chip chip-gold">{kindLabel(p)}</span>
    </div>
  </a>
  <div class="card-body">
    <h3 class="card-title"><a href={productPath(p)}>{name}</a></h3>
    <p class="price">{priceLabel(p)}</p>
    <p class="card-buy"><a class="btn btn-gold btn-sm" href={buy} rel="noopener">{p.recurrence ? "Join on Gumroad ↗" : "Buy on Gumroad ↗"}</a></p>
  </div>
</article>
