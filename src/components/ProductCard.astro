---
import { Picture } from "astro:assets";
import { img, coverImg, priceLabel, productPath, displayName, kindLabel, type Product } from "../lib/content";
const { p } = Astro.props as { p: Product };
const remote = img(p.image);
const i = remote ?? coverImg(`product-${p.slug}`);
const name = displayName(p);
---
<article class="card product-card">
  <a href={productPath(p)} class="card-link">
    <div class="card-media square">
      {i ? <Picture src={i} formats={["avif"]} fallbackFormat="webp" widths={[300, 500]} sizes="(min-width: 900px) 30vw, 90vw" alt={remote ? `Gumroad artwork for ${name}, Thought Leaders` : `Generated cover for ${name}, Thought Leaders`} loading="lazy" />
         : <div class="card-media-fallback" aria-hidden="true">VS</div>}
      <span class="chip chip-gold">{kindLabel(p)}</span>
    </div>
    <div class="card-body">
      <h3 class="card-title">{name}</h3>
      <p class="price">{priceLabel(p)}</p>
    </div>
  </a>
</article>
