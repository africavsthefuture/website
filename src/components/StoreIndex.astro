---
import { Picture } from "astro:assets";
import Base from "../layouts/Base.astro";
import ProductCard from "./ProductCard.astro";
import SubscribeForm from "./SubscribeForm.astro";
import tlLogo from "../assets/brand/tl-logo.png";
import { products, productPath, priceLabel, displayName, productSummary } from "../lib/content";
import { site, utm } from "../site.config.mjs";
const brand = site.store.brand;
const ld = [{
  "@context": "https://schema.org", "@type": "CollectionPage", name: `${brand} store`, url: `${site.url}/store`,
  description: `${brand} mini-books, podcast episodes and membership from ${site.name}, sold through Gumroad.`,
  isPartOf: { "@id": `${site.url}/#website` },
  publisher: { "@id": `${site.url}/#org` },
  mainEntity: { "@type": "ItemList", itemListElement: products.map((p, i) => ({ "@type": "ListItem", position: i + 1, url: `${site.url}${productPath(p)}`, name: displayName(p) })) },
}];
---
<Base title={`${brand}: the Africa vs The Future store`} description={`${brand} from ${site.name}: a referenced mini-book, a podcast episode and a monthly membership, sold through Gumroad.`} jsonld={ld} crumbs={[{ name: brand, path: "/store" }]}>
  <div class="wrap">
    <header class="page-head">
      <div class="tl-head">
        <div class="tl-logo"><Picture src={tlLogo} formats={["avif"]} fallbackFormat="webp" widths={[112, 224]} sizes="112px" alt="Thought Leaders logo: portrait of a man in glasses against a city skyline" loading="eager" /></div>
        <div>
          <p class="tl-parent">An <a href="/">{site.name}</a> series</p>
          <h1>{brand}</h1>
        </div>
      </div>
      <p class="lede">Longer, referenced work from {site.name}: mini-books, podcast episodes and a monthly membership. Every article stays free on this site; these are optional extras. Checkout and delivery are handled by Gumroad.</p>
    </header>
    <section aria-labelledby="tl-products">
      <h2 id="tl-products" class="section-title" style="font-size:1.6rem;margin-bottom:1rem">Available now</h2>
      <div class="grid grid-3">{products.map((p) => <ProductCard p={p} placement="store" />)}</div>
    </section>
    <section class="section" aria-labelledby="tl-list">
      <h2 id="tl-list" class="section-title" style="font-size:1.6rem;margin-bottom:1rem">At a glance</h2>
      <div class="keyfacts"><dl>{products.map((p) => <div><dt>{priceLabel(p)}</dt><dd><a href={productPath(p)}>{displayName(p)}</a>: {productSummary(p)}</dd></div>)}</dl></div>
      <p class="product-note">Prices are as listed on Gumroad and may show in your local currency at checkout. <a href={utm(site.gumroad.store, "store", "store_index")} rel="noopener">Open the {brand} store on Gumroad ↗</a></p>
    </section>
    <section class="section"><div class="two-col"><div><h2 class="section-title" style="font-size:1.6rem">Free articles by email</h2><p class="lede">New articles and podcast episodes, free in your inbox.</p></div><SubscribeForm placement="store" /></div></section>
  </div>
</Base>
