---
import "@fontsource/inter/latin-400.css";
import "@fontsource/inter/latin-600.css";
import "@fontsource/inter/latin-700.css";
import "@fontsource/outfit/latin-800.css";
import "@fontsource/outfit/latin-900.css";
import "@fontsource/ibm-plex-mono/latin-500.css";
import "@fontsource/ibm-plex-mono/latin-600.css";
import outfit800 from "@fontsource/outfit/files/outfit-latin-800-normal.woff2?url";
import inter400 from "@fontsource/inter/files/inter-latin-400-normal.woff2?url";
import plex500 from "@fontsource/ibm-plex-mono/files/ibm-plex-mono-latin-500-normal.woff2?url";
import "../styles/global.css";
import SubscribeForm from "../components/SubscribeForm.astro";
import Wordmark from "../components/Wordmark.astro";
import ChannelIcon from "../components/ChannelIcon.astro";
import { site, utm, liveChannels } from "../site.config.mjs";
import { ClientRouter } from "astro:transitions";

interface Props {
  title: string; description: string; canonical?: string; image?: string; type?: string;
  jsonld?: object[]; noindex?: boolean; published?: string; modified?: string;
}
const { title, description, canonical, image, type = "website", jsonld = [], noindex = false, published, modified } = Astro.props;
const path = Astro.url.pathname.replace(/\.html$/, "").replace(/\/index$/, "/") || "/";
const canonicalUrl = canonical ?? new URL(path, site.url).toString();
const ogImage = image ? new URL(image, site.url).toString() : `${site.url}/og/default.jpg`;
const fullTitle = title.includes(site.name) ? title : `${title} | ${site.name}`;
const channels = liveChannels();
const sameAs = channels.map((c) => c.url);
const org = {
  "@context": "https://schema.org", "@type": "Organization", "@id": `${site.url}/#org`,
  name: site.name, url: site.url, logo: `${site.url}${site.logoPath}`, description: site.description, slogan: site.tagline, sameAs,
};
const webSite = { "@context": "https://schema.org", "@type": "WebSite", "@id": `${site.url}/#website`, name: site.name, alternateName: site.shortName, slogan: site.tagline, url: site.url, publisher: { "@id": `${site.url}/#org` }, inLanguage: site.lang };
const nav = [
  { href: "/articles", label: "Articles" },
  { href: "/podcast", label: "Podcast" },
  ...(site.features.store ? [{ href: "/store", label: "Store" }] : []),
  { href: site.briefing.path, label: "Free Briefing" },
  { href: "/about", label: "About" },
];
const here = (h: string) => path === h || path.startsWith(h + "/");
const adsCfg = site.ads.enabled ? JSON.stringify({ exchanges: site.ads.exchanges }) : null;
---
<!doctype html>
<html lang={site.lang}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  {!noindex && <link rel="canonical" href={canonicalUrl} />}
  {noindex && <meta name="robots" content="noindex, follow" />}
  <meta name="theme-color" content="#0F1923" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="icon" href="/favicon.png" type="image/png" sizes="48x48" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="alternate" type="text/plain" href="/llms.txt" title="LLM summary" />
  <link rel="preload" href={outfit800} as="font" type="font/woff2" crossorigin />
  <link rel="preload" href={inter400} as="font" type="font/woff2" crossorigin />
  <link rel="preload" href={plex500} as="font" type="font/woff2" crossorigin />
  <meta property="og:site_name" content={site.name} />
  <meta property="og:type" content={type} />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:locale" content={site.locale} />
  {published && <meta property="article:published_time" content={published} />}
  {modified && <meta property="article:modified_time" content={modified} />}
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:site" content="@AfricaVTFuture" />
  <meta name="twitter:creator" content="@AfricaVTFuture" />
  <meta name="twitter:title" content={fullTitle} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />
  {channels.map((c) => <link rel="me" href={c.url} />)}
  <script type="application/ld+json" set:html={JSON.stringify([org, webSite, ...jsonld])} />
  {site.analytics.provider && site.analytics.src && (
    <script defer data-domain={site.analytics.domain} src={site.analytics.src}></script>
  )}
  <slot name="head" />
  <ClientRouter />
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>
  <header class="site-header">
    <div class="wrap header-row">
      <a href="/" class="brand" aria-label={`${site.name}: home`}><Wordmark /></a>
      <nav class="nav" id="site-nav" aria-label="Primary">
        <ul>
          {nav.map((n) => <li><a href={n.href} aria-current={here(n.href) ? "page" : undefined}>{n.label}</a></li>)}
        </ul>
      </nav>
      <a class="btn btn-gold btn-sm header-cta" href="#subscribe"><span class="cta-long">Subscribe free</span><span class="cta-short">Subscribe</span></a>
      <button class="nav-toggle" type="button" aria-controls="site-nav" aria-expanded="false" aria-label="Open menu">
        <span></span><span></span><span></span>
      </button>
    </div>
  </header>

  <main id="main"><slot /></main>

  <footer class="site-footer">
    <div class="wrap">
      <div class="footer-top">
        <div>
          <a href="/" class="brand" aria-label={`${site.name}: home`}><Wordmark size="lg" /></a>
          <p class="footer-tag"><strong>{site.tagline}.</strong> {site.supportLine}</p>
        </div>
        <div class="footer-sub" id="subscribe">
          <p class="kicker">Get every essay by email</p>
          <SubscribeForm placement="footer" id="email-footer" />
        </div>
      </div>
      <ul class="channel-list" aria-label="Our channels">
        {channels.map((c) => (
          <li>
            <a href={utm(c.url, "channels", "footer")} rel={c.rel === "me" ? "me noopener" : "noopener"} data-channel={c.id}>
              <ChannelIcon id={c.id} size={14} />
              {c.label}
            </a>
          </li>
        ))}
      </ul>
      <div class="footer-bottom">
        <nav aria-label="Footer"><a href="/about">About</a><a href="/contact">Contact</a><a href="/privacy">Privacy</a><a href="/llms.txt">llms.txt</a><a href="/sitemap-index.xml">Sitemap</a></nav>
        <p>© {new Date().getFullYear()} {site.name}</p>
      </div>
    </div>
  </footer>

  <div class="sticky-sub" data-sticky-sub>
    <p><strong>Free essays</strong> by email</p>
    <a class="btn btn-gold btn-sm" href="#subscribe">Subscribe</a>
  </div>

  <div id="consent-root" data-cmp={site.consent.cmp ?? ""} hidden></div>

  <script>import "../scripts/ui.ts";</script>
  {adsCfg && (<>
    <script is:inline set:html={`window.AVTF_ADS=${adsCfg};`} />
    <script is:inline src="/js/ads.js" defer></script>
  </>)}
</body>
</html>
